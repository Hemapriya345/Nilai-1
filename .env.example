# Data source: synthetic | csv | serial | ble
NILAI_SOURCE=synthetic

# ESP32 over USB
NILAI_SERIAL_PORT=/dev/ttyUSB0
NILAI_SERIAL_BAUD=115200

# CSV replay
NILAI_CSV_PATH=data/sample/tremor.csv

# NPG Lite over BLE (needs: pip install bleak)
NILAI_BLE_ADDRESS=
NILAI_BLE_CHAR_UUID=

# Signal processing
NILAI_FS=250
NILAI_WINDOW_S=3.0
NILAI_HOP_S=0.5
NILAI_REST_GYRO_RMS=2.0
NILAI_TREMOR_BAND_RATIO=0.5
NILAI_COHERENCE_MIN=0.6

# Dashboard
NILAI_HOST=127.0.0.1
NILAI_PORT=5000
